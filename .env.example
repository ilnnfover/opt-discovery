# 路径配置示例：复制为 .env.local 后按本机情况填写（.env.local 不入库）
#
#   cp .env.example .env.local
#   source .env.local

# profiler 导出根目录（其下放置 <export_dir>/PROF_*/ 与 workload.log）
export PROF_ROOT=/path/to/profiler/exports

# NPU 源码树根目录（含 vllm / vllm-ascend 源码，供 source-map 索引）
export NPU_STACK=/path/to/npu-stack

# 模型目录（采集 harness 使用）
export MODEL_PATH=/path/to/Qwen3.5-35B-A3B

# 供命令读取的变量（由上面三个派生，一般无需修改）
export OPT_DISCOVERY_DATA_ROOT="${PROF_ROOT}"
export OPT_DISCOVERY_REPOS="${NPU_STACK}/vllm-ascend:${NPU_STACK}/vllm"
